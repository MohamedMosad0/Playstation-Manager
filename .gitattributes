# Set default behavior for git to handle line endings automatically
* text=auto eol=lf

# Explicitly declare text files that must use LF line endings (Unix style)
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.toml text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
gradlew text eol=lf

# Windows batch files must use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text eol=lf
*.jar binary
*.aar binary
*.so binary
