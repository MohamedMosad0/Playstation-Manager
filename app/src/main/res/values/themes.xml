<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Application Theme — DayNight, responds to MODE_NIGHT_YES/NO/FOLLOW_SYSTEM -->
    <style name="Base.Theme.PlayStation" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary Colors -->
        <item name="colorPrimary">@color/ps_blue_primary</item>
        <item name="colorPrimaryVariant">@color/ps_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary Colors -->
        <item name="colorSecondary">@color/ps_button_triangle</item>
        <item name="colorSecondaryVariant">@color/ps_button_square</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Background / Surface (resolved from values/ or values-night/ at runtime) -->
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status / Navigation Bar -->
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>

        <!-- Text Appearance -->
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Error Color -->
        <item name="colorError">@color/error</item>
    </style>

    <!-- Main Application Theme -->
    <style name="Theme.PlayStation" parent="Base.Theme.PlayStation" />

    <!-- Unified Screen Header Style -->
    <style name="Widget.PlayStation.ScreenHeader" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="Widget.PlayStation.ScreenHeader.Logo" parent="">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:tint">?attr/colorPrimary</item>
    </style>

    <style name="Widget.PlayStation.ScreenHeader.Title" parent="TextAppearance.PlayStation.Headline">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Standardized Empty State Style -->
    <style name="Widget.PlayStation.EmptyStateContainer" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">32dp</item>
    </style>

    <style name="Widget.PlayStation.EmptyStateIcon" parent="">
        <item name="android:layout_width">100dp</item>
        <item name="android:layout_height">100dp</item>
        <item name="android:alpha">0.4</item>
        <item name="android:tint">@color/text_secondary</item>
    </style>

    <style name="Widget.PlayStation.EmptyStateTitle" parent="TextAppearance.PlayStation.Title">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textAlignment">center</item>
    </style>

    <style name="Widget.PlayStation.EmptyStateSubtitle" parent="TextAppearance.PlayStation.Body">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textAlignment">center</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.PlayStation.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_ps_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.PlayStation</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
    </style>

    <!-- Card Style -->
    <style name="Widget.PlayStation.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/card_dark</item>
        <item name="cardElevation">4dp</item>
        <item name="cardCornerRadius">16dp</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.PlayStation.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Widget.PlayStation.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/ps_blue_primary</item>
    </style>

    <!-- Text Styles -->
    <style name="TextAppearance.PlayStation.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.PlayStation.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.PlayStation.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Theme.PlayStation.Dialog.FullScreen" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="colorPrimary">@color/ps_blue_primary</item>
        <item name="colorSecondary">@color/ps_blue_light</item>
    </style>
</resources>