<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:descendantFocusability="beforeDescendants">

        <!-- Unified Header -->
        <LinearLayout
            style="@style/Widget.PlayStation.ScreenHeader">

            <ImageView
                style="@style/Widget.PlayStation.ScreenHeader.Logo"
                android:src="@drawable/ic_settings"
                android:contentDescription="@null" />

            <TextView
                style="@style/Widget.PlayStation.ScreenHeader.Title"
                android:text="@string/nav_settings" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- General Section -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PlayStation.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.PlayStation.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="@string/settings_general" />

                    <!-- Dark Mode -->
                    <LinearLayout
                        style="@style/Widget.PlayStation.Preference">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            
                            <TextView
                                style="@style/TextAppearance.PlayStation.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_dark_mode" />
                                
                            <TextView
                                style="@style/TextAppearance.PlayStation.Body.Small"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/settings_dark_mode_subtitle" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchDarkMode"
                            style="@style/Widget.PlayStation.Switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:saveEnabled="false" />
                    </LinearLayout>

                    <!-- Notifications -->
                    <LinearLayout
                        style="@style/Widget.PlayStation.Preference">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            
                            <TextView
                                style="@style/TextAppearance.PlayStation.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_notifications" />
                                
                            <TextView
                                style="@style/TextAppearance.PlayStation.Body.Small"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/settings_notifications_subtitle" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchNotifications"
                            style="@style/Widget.PlayStation.Switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:saveEnabled="false" />
                    </LinearLayout>

                    <!-- Language -->
                    <LinearLayout
                        style="@style/Widget.PlayStation.Preference.Vertical">

                        <TextView
                            style="@style/TextAppearance.PlayStation.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="@string/settings_language" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.PlayStation.TextInputLayout.Dropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:hintEnabled="false">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/actvLanguage"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:saveEnabled="false"
                                android:focusable="false"
                                android:focusableInTouchMode="false" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Currency -->
                    <LinearLayout
                        style="@style/Widget.PlayStation.Preference.Vertical"
                        android:layout_marginBottom="0dp">

                        <TextView
                            style="@style/TextAppearance.PlayStation.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="@string/settings_currency" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.PlayStation.TextInputLayout.Dropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:hintEnabled="false">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/actvCurrency"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:saveEnabled="false"
                                android:focusable="false"
                                android:focusableInTouchMode="false" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- PlayStation 4 Section -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PlayStation.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.PlayStation.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="@string/ps4" />

                    <LinearLayout
                        style="@style/Widget.PlayStation.Preference.Vertical">

                        <TextView
                            style="@style/TextAppearance.PlayStation.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="@string/settings_hour_price" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilPs4HourPrice"
                            style="@style/Widget.PlayStation.TextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:hintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPs4HourPrice"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/tvPs4HourPriceSaved"
                            style="@style/TextAppearance.PlayStation.Body.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="4dp"
                            android:text="@string/settings_saved"
                            android:textColor="?attr/colorPrimary"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/Widget.PlayStation.Preference.Vertical"
                        android:layout_marginBottom="0dp">

                        <TextView
                            style="@style/TextAppearance.PlayStation.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="@string/ps4_multi_extra" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilPs4MultiExtra"
                            style="@style/Widget.PlayStation.TextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:hintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPs4MultiExtra"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/tvPs4MultiExtraSaved"
                            style="@style/TextAppearance.PlayStation.Body.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="4dp"
                            android:text="@string/settings_saved"
                            android:textColor="?attr/colorPrimary"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- PlayStation 5 Section -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PlayStation.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.PlayStation.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="@string/ps5" />

                    <LinearLayout
                        style="@style/Widget.PlayStation.Preference.Vertical">

                        <TextView
                            style="@style/TextAppearance.PlayStation.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="@string/settings_hour_price" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilPs5HourPrice"
                            style="@style/Widget.PlayStation.TextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:hintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPs5HourPrice"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/tvPs5HourPriceSaved"
                            style="@style/TextAppearance.PlayStation.Body.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="4dp"
                            android:text="@string/settings_saved"
                            android:textColor="?attr/colorPrimary"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/Widget.PlayStation.Preference.Vertical"
                        android:layout_marginBottom="0dp">

                        <TextView
                            style="@style/TextAppearance.PlayStation.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="@string/ps5_multi_extra" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilPs5MultiExtra"
                            style="@style/Widget.PlayStation.TextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:hintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPs5MultiExtra"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/tvPs5MultiExtraSaved"
                            style="@style/TextAppearance.PlayStation.Body.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="4dp"
                            android:text="@string/settings_saved"
                            android:textColor="?attr/colorPrimary"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Alerts Section -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PlayStation.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.PlayStation.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="@string/settings_alerts" />

                    <LinearLayout
                        style="@style/Widget.PlayStation.Preference.Vertical"
                        android:layout_marginBottom="0dp">

                        <TextView
                            style="@style/TextAppearance.PlayStation.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="@string/settings_reminder_minutes" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilReminderMinutes"
                            style="@style/Widget.PlayStation.TextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:hintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etReminderMinutes"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/tvReminderMinutesSaved"
                            style="@style/TextAppearance.PlayStation.Body.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="4dp"
                            android:text="@string/settings_saved"
                            android:textColor="?attr/colorPrimary"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Data Section -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PlayStation.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.PlayStation.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="@string/settings_data" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBackup"
                        style="@style/Widget.PlayStation.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="@string/settings_backup"
                        app:icon="@drawable/ic_backup" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRestore"
                        style="@style/Widget.PlayStation.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_restore"
                        app:icon="@drawable/ic_restore" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- About Section -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PlayStation.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.PlayStation.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="@string/settings_about" />

                    <LinearLayout
                        style="@style/Widget.PlayStation.Preference.Vertical"
                        android:layout_marginBottom="8dp">
                            
                        <TextView
                            android:id="@+id/tvAppVersion"
                            style="@style/TextAppearance.PlayStation.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            tools:text="1.0.0" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/Widget.PlayStation.Preference.Vertical"
                        android:layout_marginBottom="0dp">
                            
                        <TextView
                            android:id="@+id/tvDeveloper"
                            style="@style/TextAppearance.PlayStation.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            tools:text="Mohamed" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Extra spacing -->
            <View
                android:layout_width="match_parent"
                android:layout_height="32dp" />

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
