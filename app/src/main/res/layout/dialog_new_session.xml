<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/spacing_large"
    android:paddingVertical="@dimen/spacing_medium"
    android:orientation="vertical">
    <!-- Device Number -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/device_number"
        android:textColor="@color/text_primary"
        android:textAppearance="@style/TextAppearance.PlayStation.Body"
        android:fontFamily="sans-serif-medium" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        style="@style/Widget.PlayStation.Dialog.Field.Compact">

        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/spinnerDeviceNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- PS4 / PS5 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/console_type"
        android:textColor="@color/text_primary"
        android:textAppearance="@style/TextAppearance.PlayStation.Body"
        android:fontFamily="sans-serif-medium" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleConsoleType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_segmented_control"
        android:padding="0dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPs4"
            style="@style/Widget.PlayStation.Selection.SegmentedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/ps4"
            />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPs5"
            style="@style/Widget.PlayStation.Selection.SegmentedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/ps5"
            />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Open / Fixed -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/session_mode"
        android:textColor="@color/text_primary"
        android:textAppearance="@style/TextAppearance.PlayStation.Body"
        android:fontFamily="sans-serif-medium" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleSessionMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_segmented_control"
        android:padding="0dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeOpen"
            style="@style/Widget.PlayStation.Selection.SegmentedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/session_mode_open"
            />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeFixed"
            style="@style/Widget.PlayStation.Selection.SegmentedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/session_mode_fixed"
            />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Fixed duration (visible only when Fixed) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilFixedDuration"
        style="@style/Widget.PlayStation.Dialog.Field.Compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        android:hint="@string/session_duration_minutes"
        app:suffixText="@string/minutes"
        app:suffixTextColor="@color/text_secondary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etFixedDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Multi Player -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="@string/multiplayer"
            android:textColor="@color/text_primary"
            android:textAppearance="@style/TextAppearance.PlayStation.Body"
            android:fontFamily="sans-serif-medium" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchMultiPlayer"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minHeight="48dp" />

    </LinearLayout>

    <!-- Live price preview -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/surface_dark"
        app:strokeColor="@color/ps_blue_primary"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_medium"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/price_preview"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.PlayStation.Body.Small" />

            <TextView
                android:id="@+id/tvPricePreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:textColor="@color/ps_blue_primary"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:textDirection="firstStrong"
                android:textAlignment="viewStart"
                tools:text="30.00 ج.م / الساعة" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
