<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    style="@style/Widget.PlayStation.Card">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Device Badge -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDeviceBadge"
            android:layout_width="56dp"
            android:layout_height="64dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/ps_blue_primary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/ivDeviceIconBadge"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_ps_logo"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tvDeviceTypeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="PS4" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Device Name -->
        <TextView
            android:id="@+id/tvDeviceName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            tools:text="PS4 #1"
            app:layout_constraintTop_toTopOf="@id/cardDeviceBadge"
            app:layout_constraintStart_toEndOf="@id/cardDeviceBadge"
            app:layout_constraintEnd_toStartOf="@id/tvDuration" />

        <!-- Session Type -->
        <TextView
            android:id="@+id/tvSessionType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            tools:text="لاعب واحد"
            app:layout_constraintTop_toBottomOf="@id/tvDeviceName"
            app:layout_constraintStart_toStartOf="@id/tvDeviceName"
            app:layout_constraintEnd_toEndOf="@id/tvDeviceName" />

        <!-- Duration -->
        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textColor="@color/ps_blue_primary"
            android:fontFamily="sans-serif-medium"
            tools:text="01:23:45"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Status Badge -->
        <TextView
            android:id="@+id/tvSessionMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_rounded_status"
            tools:text="يعمل"
            tools:backgroundTint="#1A4CAF50"
            tools:textColor="#4CAF50"
            app:layout_constraintTop_toBottomOf="@id/tvSessionType"
            app:layout_constraintStart_toStartOf="@id/tvDeviceName" />

        <!-- Divider -->
        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/divider"
            app:layout_constraintTop_toBottomOf="@id/tvSessionMode"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Price Label -->
        <TextView
            android:id="@+id/tvPriceLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/rate"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Price Value -->
        <TextView
            android:id="@+id/tvPriceValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            tools:text="30.00 ج.م/ساعة"
            app:layout_constraintTop_toTopOf="@id/tvPriceLabel"
            app:layout_constraintBottom_toBottomOf="@id/tvPriceLabel"
            app:layout_constraintStart_toEndOf="@id/tvPriceLabel"
            android:layout_marginStart="8dp" />

        <!-- Total Label -->
        <TextView
            android:id="@+id/tvTotalLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/total"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            app:layout_constraintTop_toTopOf="@id/tvPriceLabel"
            app:layout_constraintEnd_toStartOf="@id/tvTotalValue" />

        <!-- Total Value -->
        <TextView
            android:id="@+id/tvTotalValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@color/ps_button_triangle"
            android:fontFamily="sans-serif-medium"
            tools:text="45.50 ج.م"
            app:layout_constraintTop_toTopOf="@id/tvTotalLabel"
            app:layout_constraintBottom_toBottomOf="@id/tvTotalLabel"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="8dp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:id="@+id/layoutActions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="end"
            app:layout_constraintTop_toBottomOf="@id/tvPriceLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Pause/Resume Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPauseResume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pause_session"
                android:textSize="12sp"
                style="@style/Widget.PlayStation.Button.Outlined"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="8dp" />

            <!-- End Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/end_session"
                android:textSize="12sp"
                style="@style/Widget.PlayStation.Button"
                android:paddingHorizontal="16dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>