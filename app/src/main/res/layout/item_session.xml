<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    style="@style/Widget.PlayStation.Card">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Device Icon -->
        <ImageView
            android:id="@+id/ivDeviceIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_ps_logo"
            android:contentDescription="@string/device"
            app:tint="@color/ps_blue_primary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Device Name -->
        <TextView
            android:id="@+id/tvDeviceName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            tools:text="PS5 #1"
            app:layout_constraintTop_toTopOf="@id/ivDeviceIcon"
            app:layout_constraintStart_toEndOf="@id/ivDeviceIcon"
            app:layout_constraintEnd_toStartOf="@id/tvDuration" />

        <!-- Session Type -->
        <TextView
            android:id="@+id/tvSessionType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            tools:text="لاعب واحد"
            app:layout_constraintTop_toBottomOf="@id/tvDeviceName"
            app:layout_constraintStart_toStartOf="@id/tvDeviceName"
            app:layout_constraintEnd_toEndOf="@id/tvDeviceName" />

        <!-- Duration -->
        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textColor="@color/ps_blue_primary"
            android:fontFamily="sans-serif-medium"
            tools:text="01:23:45"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Status Indicator -->
        <View
            android:id="@+id/viewStatusIndicator"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/status_active"
            app:layout_constraintTop_toTopOf="@id/tvDuration"
            app:layout_constraintBottom_toBottomOf="@id/tvDuration"
            app:layout_constraintEnd_toStartOf="@id/tvDuration" />

        <!-- Divider -->
        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/divider"
            app:layout_constraintTop_toBottomOf="@id/ivDeviceIcon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Price Label -->
        <TextView
            android:id="@+id/tvPriceLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/rate"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Price Value -->
        <TextView
            android:id="@+id/tvPriceValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            tools:text="30.00 ج.م/ساعة"
            app:layout_constraintTop_toTopOf="@id/tvPriceLabel"
            app:layout_constraintBottom_toBottomOf="@id/tvPriceLabel"
            app:layout_constraintStart_toEndOf="@id/tvPriceLabel"
            android:layout_marginStart="8dp" />

        <!-- Total Label -->
        <TextView
            android:id="@+id/tvTotalLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/total"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            app:layout_constraintTop_toTopOf="@id/tvPriceLabel"
            app:layout_constraintEnd_toStartOf="@id/tvTotalValue" />

        <!-- Total Value -->
        <TextView
            android:id="@+id/tvTotalValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@color/ps_button_triangle"
            android:fontFamily="sans-serif-medium"
            tools:text="45.50 ج.م"
            app:layout_constraintTop_toTopOf="@id/tvTotalLabel"
            app:layout_constraintBottom_toBottomOf="@id/tvTotalLabel"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="8dp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:id="@+id/layoutActions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="end"
            app:layout_constraintTop_toBottomOf="@id/tvPriceLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Pause/Resume Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPauseResume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pause_session"
                android:textSize="12sp"
                style="@style/Widget.PlayStation.Button.Outlined"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="8dp" />

            <!-- End Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/end_session"
                android:textSize="12sp"
                style="@style/Widget.PlayStation.Button"
                android:paddingHorizontal="16dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>