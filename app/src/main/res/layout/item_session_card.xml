<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardSession"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    style="@style/Widget.PlayStation.Card">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Device Badge -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDeviceBadge"
            android:layout_width="52dp"
            android:layout_height="52dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/ps_blue_primary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/ivDeviceIconBadge"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_gamepad"
                app:tint="@android:color/white"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Device Name -->
        <TextView
            android:id="@+id/tvDeviceName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            tools:text="PS4 #1"
            app:layout_constraintTop_toTopOf="@id/cardDeviceBadge"
            app:layout_constraintBottom_toBottomOf="@id/cardDeviceBadge"
            app:layout_constraintVertical_bias="0.25"
            app:layout_constraintStart_toEndOf="@id/cardDeviceBadge"
            app:layout_constraintEnd_toStartOf="@id/tvTimer" />

        <!-- Session mode badge -->
        <TextView
            android:id="@+id/tvSessionMode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="مفتوحة • لاعب واحد"
            app:layout_constraintTop_toBottomOf="@id/tvDeviceName"
            app:layout_constraintStart_toStartOf="@id/tvDeviceName"
            app:layout_constraintEnd_toStartOf="@id/tvTimer" />

        <!-- Status Label -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="11sp"
            android:textColor="@color/status_active"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_rounded_status"
            tools:text="يعمل"
            tools:backgroundTint="#1A4CAF50"
            app:layout_constraintTop_toBottomOf="@id/tvSessionMode"
            app:layout_constraintStart_toStartOf="@id/tvDeviceName" />

        <!-- Timer -->
        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/ps_blue_primary"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.03"
            tools:text="01:23:45"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
