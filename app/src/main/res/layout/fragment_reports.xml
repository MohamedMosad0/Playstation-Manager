<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Unified Header -->
        <LinearLayout
            style="@style/Widget.PlayStation.ScreenHeader">

            <ImageView
                style="@style/Widget.PlayStation.ScreenHeader.Logo"
                android:src="@drawable/ic_reports"
                android:contentDescription="@null" />

            <TextView
                style="@style/Widget.PlayStation.ScreenHeader.Title"
                android:text="@string/reports" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Date Range Selector -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDateRange"
            style="@style/Widget.PlayStation.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/ps_blue_primary"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:id="@+id/tvDateRange"
                        style="@style/TextAppearance.PlayStation.Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        tools:text="2026/06/01 - 2026/06/30" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="@color/text_secondary"
                        tools:ignore="ContentDescription" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupDateFilters"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipToday"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/today" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipLast7Days"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/last_7_days" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipThisMonth"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/this_month" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipLast30Days"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/last_30_days" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAllTime"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/all_time" />

                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- KPI Grid -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:useDefaultMargins="true"
            android:layout_marginHorizontal="-4dp">

            <!-- Total Revenue -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PlayStation.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:contentPadding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reports_total_revenue"
                        app:drawableStartCompat="@drawable/ic_receipt"
                        android:drawablePadding="8dp"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary" />
                    <TextView
                        android:id="@+id/tvTotalRevenue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary"
                        tools:text="0.0 EGP" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Total Expenses -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PlayStation.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:contentPadding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reports_total_expenses"
                        app:drawableStartCompat="@drawable/ic_expenses"
                        android:drawablePadding="8dp"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary" />
                    <TextView
                        android:id="@+id/tvTotalExpenses"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/chart_red"
                        tools:text="0.0 EGP" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Session Revenue -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PlayStation.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:contentPadding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reports_sessions_revenue"
                        app:drawableStartCompat="@drawable/ic_gamepad"
                        android:drawablePadding="8dp"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary" />
                    <TextView
                        android:id="@+id/tvSessionRevenue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="0.0 EGP" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Product Revenue -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PlayStation.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:contentPadding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reports_products_revenue"
                        app:drawableStartCompat="@drawable/ic_package"
                        android:drawablePadding="8dp"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary" />
                    <TextView
                        android:id="@+id/tvProductRevenue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="0.0 EGP" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Total Sessions -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PlayStation.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:contentPadding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reports_total_sessions"
                        app:drawableStartCompat="@drawable/ic_gamepad"
                        android:drawablePadding="8dp"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary" />
                    <TextView
                        android:id="@+id/tvTotalSessions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="0" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Avg Duration -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PlayStation.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:contentPadding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reports_average_duration"
                        app:drawableStartCompat="@drawable/ic_timer"
                        android:drawablePadding="8dp"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary" />
                    <TextView
                        android:id="@+id/tvAvgDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="0 دقيقة" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </GridLayout>


        <!-- Historical Cost Gap Warning -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHistoricalWarning"
            style="@style/Widget.PlayStation.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="#1AE6A800">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/status_paused"
                    tools:ignore="ContentDescription" />
                <TextView
                    android:id="@+id/tvHistoricalWarning"
                    style="@style/TextAppearance.PlayStation.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:textSize="12sp"
                    android:textColor="@color/status_paused"
                    android:text="@string/reports_old_products_warning" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Profit Cards Row -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:useDefaultMargins="true"
            android:layout_marginHorizontal="-4dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp">

            <!-- Product Cost -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PlayStation.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:contentPadding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reports_products_cost"
                        app:drawableStartCompat="@drawable/ic_expenses"
                        android:drawablePadding="8dp"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary" />
                    <TextView
                        android:id="@+id/tvProductCost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/chart_red"
                        tools:text="0.0 EGP" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Product Profit -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PlayStation.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:contentPadding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reports_products_profit"
                        app:drawableStartCompat="@drawable/ic_purchases"
                        android:drawablePadding="8dp"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary" />
                    <TextView
                        android:id="@+id/tvProductProfit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/chart_green"
                        tools:text="0.0 EGP" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Net Profit (full width) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PlayStation.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="2"
                android:layout_margin="4dp"
                app:cardBackgroundColor="@color/ps_blue_dark">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_wallet"
                        app:tint="@color/white"
                        tools:ignore="ContentDescription" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/reports_net_profit"
                            android:textColor="@color/white"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/tvNetProfit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            tools:text="0.0 EGP" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </GridLayout>


        <!-- BarChart: Revenue Last 7 Days -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.PlayStation.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    style="@style/TextAppearance.PlayStation.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reports_last_7_days_revenue" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/reports_chart_subtitle_period"
                    android:textSize="12sp"
                    android:textColor="@color/text_disabled" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/divider"
                    android:alpha="0.4" />

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/barChartRevenue"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- PieChart: Revenue Distribution -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.PlayStation.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    style="@style/TextAppearance.PlayStation.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reports_revenue_distribution" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/reports_chart_subtitle_distribution"
                    android:textSize="12sp"
                    android:textColor="@color/text_disabled" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/divider"
                    android:alpha="0.4" />

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieChartRevenue"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- PieChart: Device Distribution -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.PlayStation.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    style="@style/TextAppearance.PlayStation.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reports_sessions_distribution" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/reports_chart_subtitle_devices"
                    android:textSize="12sp"
                    android:textColor="@color/text_disabled" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/divider"
                    android:alpha="0.4" />

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieChartDevices"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

            <!-- Top Products -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PlayStation.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        style="@style/TextAppearance.PlayStation.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="@string/reports_top_products" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/divider"
                        android:alpha="0.4" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvTopProducts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:paddingBottom="8dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="5"
                        tools:listitem="@layout/item_top_product" />

                    <!-- Standardized Empty State -->
                    <LinearLayout
                        android:id="@+id/layoutEmpty"
                        style="@style/Widget.PlayStation.EmptyStateContainer"
                        android:visibility="gone"
                        android:padding="24dp">

                        <ImageView
                            style="@style/Widget.PlayStation.EmptyStateIcon"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:src="@drawable/ic_reports"
                            android:contentDescription="@null" />

                        <TextView
                            style="@style/Widget.PlayStation.EmptyStateTitle"
                            android:text="@string/reports_empty_title" />

                        <TextView
                            style="@style/Widget.PlayStation.EmptyStateSubtitle"
                            android:text="@string/reports_empty_subtitle" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        <!-- Extra spacing -->
        <View
            android:layout_width="match_parent"
            android:layout_height="32dp" />

    </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
